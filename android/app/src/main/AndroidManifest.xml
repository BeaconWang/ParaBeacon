<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Bluetooth Low Energy (external flight sensors). Android 12+ uses the
         BLUETOOTH_SCAN / BLUETOOTH_CONNECT runtime permissions; older versions
         fall back to location. usesPermissionFlags="neverForLocation" declares
         we don't derive physical location from BLE scans. -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Legacy permissions for Android 11 and below. -->
    <uses-permission android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />

    <!-- Fine + coarse location: used by legacy BLE scanning (Android 11-) and
         by the Map control's device GPS (geolocator) across all SDK levels. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Background location (Android 10+): requested for automatic detection
         and background-only location access. A location foreground service
         started while the app is visible can continue with foreground location
         access; starting that service from the background requires this grant. -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- Required to download online map tiles for the Map control. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Background execution: during a flight or while Android automatic
         detection is enabled, geolocator starts its location foreground service
         with an ongoing notification. The service declaration and
         foregroundServiceType="location" are supplied by geolocator_android
         and merged into the final manifest. WAKE_LOCK permits the plugin's CPU
         wake lock while tracking; the screen-awake wakelock is separate.
         FOREGROUND_SERVICE is required for foreground services; Android 14+
         location services also require FOREGROUND_SERVICE_LOCATION. Android 13+
         POST_NOTIFICATIONS is requested at runtime for notification-drawer
         visibility, but denying it does not itself prevent starting the service. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:label="ParaBeacon"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Android 11+ package visibility: without this the app cannot see or
             bind to the installed text-to-speech engine(s), so flutter_tts
             fails to initialize and altitude voice announcements stay silent. -->
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE"/>
        </intent>
    </queries>
</manifest>
